{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "SkyBlock recipe viewing for Reliable Recipe Viewer (RRV). View crafting, forge, drops, NPC shop, essence upgrade, and more recipe types for 8,000+ SkyBlock items.",
  "authors": [
    "SkyRecipes Contributors"
  ],
  "contact": {
    "sources": "https://github.com/kdgaming0/SkyRecipes"
  },
  "license": "MIT",
  "icon": "assets/skyrecipes/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.github.kdgaming0.skyrecipes.SkyRecipes"
    ],
    "rrv": [
      "com.github.kdgaming0.skyrecipes.rrv.plugin.SkyRecipesPlugin"
    ],
    "rrv_client": [
      "com.github.kdgaming0.skyrecipes.rrv.plugin.SkyRecipesClientPlugin"
    ]
  },
  "mixins": [
    "skyrecipes.mixins.json"
  ],
  "accessWidener": "skyrecipes.ct",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft}",
    "fabric-api": "*",
    "midnightlib": ">=1.9.3"
  },
  "recommends": {
    "rrv": ">=8.0.0"
  }
}
